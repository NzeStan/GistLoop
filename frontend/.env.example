# Where the Django API runs in development (Vite proxies /api and /bff to it).
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000

# Browser push notifications (optional): from the Firebase console, Project settings → General (web app)
# and Cloud Messaging → Web Push certificates. The backend needs FCM_PROJECT_ID and FCM_CREDENTIALS_FILE.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
