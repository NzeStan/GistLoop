# GistLoop API: Django + the University packages from PyPI, served by gunicorn.
FROM python:3.13-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
RUN useradd --create-home --uid 10001 gistloop

COPY backend/requirements.txt .
RUN pip install -r requirements.txt

COPY backend/ .
# collectstatic needs settings but no secrets; it runs with throwaway values at build time only.
RUN DJANGO_DEBUG=true python manage.py collectstatic --noinput \
    && mkdir -p media private-media && chown gistloop:gistloop media private-media

USER gistloop
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live/')"
CMD ["gunicorn", "gistloop.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--access-logfile", "-", "--forwarded-allow-ips", "*"]
