# Copy to .env (never commit it) and fill in. Development works with only DJANGO_DEBUG=true.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# The public website (email links point here).
FRONTEND_URL=http://localhost:5173

# Dedicated secrets. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=
UNIVERSITY_HMAC_KEY=
# Fernet key(s) for anonymous identities:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ANONYMOUS_IDENTITY_KEYS=
# Fernet key(s) for direct messages at rest (generate like the anonymous keys).
MESSAGING_ENCRYPTION_KEYS=

# Paystack (https://dashboard.paystack.com/#/settings/developers). Use sk_test_... until launch.
# Webhook URL to set in the dashboard: https://YOUR-DOMAIN/api/v1/payments/webhooks/paystack/
# Empty in development: a built-in test provider completes payments instantly.
PAYSTACK_SECRET_KEY=

# "Continue with Google / Yahoo / GitHub". Each button appears once its ID and secret are set.
# Redirect (callback) URL to register with each provider: {FRONTEND_URL}/auth/callback/<google|yahoo|github>
#   Google: https://console.cloud.google.com/apis/credentials (OAuth client ID, type "Web application")
#   Yahoo:  https://developer.yahoo.com/apps/ (OpenID Connect permissions: Email, Profile)
#   GitHub: https://github.com/settings/developers (OAuth App)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_YAHOO_CLIENT_ID=
OAUTH_YAHOO_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------------------------
# GistLoop's own social media accounts. Podcast episodes are shared when published (set
# SYNDICATION_AUTO_APPROVE_PODCASTS=false to review them first); anonymous gist only when its author
# opts in AND an editor approves it (give editors the "Social media editor" role in the admin).
# Each channel turns on once all of its keys are set. The platforms fetch images and videos from
# PUBLIC_BASE_URL (your public https address; defaults to FRONTEND_URL).
PUBLIC_BASE_URL=
SYNDICATION_AUTO_APPROVE_PODCASTS=true
# Facebook Page: a long-lived Page access token with pages_manage_posts (Meta for Developers).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Instagram professional account linked to that Page (instagram_content_publish). The token
# defaults to the Page token.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
# X: a project app with Read and Write permission; the access token and secret of the GistLoop account.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_HANDLE=
# Telegram: create a bot with @BotFather, add it as an admin of your channel. Chat ID: @yourchannel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TikTok (videos only: podcast episodes with an uploaded video). Content Posting API, Direct Post.
# Until TikTok audits the app, posts can only be private (SELF_ONLY).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# Colours of the image cards (match frontend/src/config/brand.ts).
BRAND_PRIMARY=#6D28D9
BRAND_ACCENT=#FF6B57

# "Email me a sign-in code" on the sign-in page (true/false).
PASSWORDLESS_LOGIN=true

# Push notifications (phones and web browsers) through Firebase Cloud Messaging. Backend: the project
# ID and the path to a service-account JSON key (never commit it). The website also needs the
# VITE_FIREBASE_* values in frontend/.env (see frontend/.env.example).
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=

# Podcasts: automatic transcripts (https://deepgram.com, optional).
DEEPGRAM_API_KEY=
# Big audio/video uploads straight to object storage (optional; needs boto3 and AWS_* credentials).
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ENDPOINT_URL=
# FFmpeg transcodes audio/video and makes clips. Detected automatically; force with true/false.
MEDIA_FFMPEG=

# Public uploads. With object storage + CDN: MEDIA_URL=https://cdn.example.com/media/ and SERVE_MEDIA=false.
MEDIA_URL=/media/
SERVE_MEDIA=true

# Services (docker compose up -d starts these locally). Leave empty for SQLite + in-memory cache.
DATABASE_URL=postgres://gistloop:gistloop@localhost:5432/gistloop
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=

# Email. Locally, Mailpit catches everything at http://localhost:8025.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=GistLoop <no-reply@gistloop.example>
# Where contact-form messages are delivered (comma-separated).
CONTACT_RECIPIENTS=hello@gistloop.example

# Production behind a TLS-terminating proxy (nginx, a load balancer).
TRUSTED_PROXY_COUNT=0
BEHIND_TLS_PROXY=true
CSRF_TRUSTED_ORIGINS=

# SMS (optional), e.g. university.core.providers.sms.TermiiSMSProvider
SMS_PROVIDER=university.core.providers.sms.ConsoleSMSProvider
SMS_API_KEY=
SMS_SENDER_ID=GistLoop
