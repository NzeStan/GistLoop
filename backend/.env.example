# Copy to .env (never commit it) and fill in. Development works with only DJANGO_DEBUG=true.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# The public website (email links point here).
FRONTEND_URL=http://localhost:5173

# Dedicated secrets. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=
UNIVERSITY_HMAC_KEY=
# Fernet key(s) for anonymous identities:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ANONYMOUS_IDENTITY_KEYS=
# Fernet key(s) for direct messages at rest (generate like the anonymous keys).
MESSAGING_ENCRYPTION_KEYS=

# Paystack (https://dashboard.paystack.com/#/settings/developers). Use sk_test_... until launch.
# Webhook URL to set in the dashboard: https://YOUR-DOMAIN/api/v1/payments/webhooks/paystack/
# Empty in development: a built-in test provider completes payments instantly.
PAYSTACK_SECRET_KEY=

# Public uploads. With object storage + CDN: MEDIA_URL=https://cdn.example.com/media/ and SERVE_MEDIA=false.
MEDIA_URL=/media/
SERVE_MEDIA=true

# Services (docker compose up -d starts these locally). Leave empty for SQLite + in-memory cache.
DATABASE_URL=postgres://gistloop:gistloop@localhost:5432/gistloop
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=

# Email. Locally, Mailpit catches everything at http://localhost:8025.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=GistLoop <no-reply@gistloop.example>
# Where contact-form messages are delivered (comma-separated).
CONTACT_RECIPIENTS=hello@gistloop.example

# Production behind a TLS-terminating proxy (nginx, a load balancer).
TRUSTED_PROXY_COUNT=0
BEHIND_TLS_PROXY=true
CSRF_TRUSTED_ORIGINS=

# SMS (optional), e.g. university.core.providers.sms.TermiiSMSProvider
SMS_PROVIDER=university.core.providers.sms.ConsoleSMSProvider
SMS_API_KEY=
SMS_SENDER_ID=GistLoop
